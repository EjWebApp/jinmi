# 카페24 서버용 설정 — 이 파일을 .env.cafe24 로 복사해서 값을 채우세요.
# .env.cafe24 는 git 저장소(작업 기록)에는 들어가지 않고, 배포할 때만 서버에 .env 로 올라갑니다.

# 카페24에 올릴 git 주소 (카페24 관리 화면 > 앱 관리 에서 확인)
# 예: https://아이디@아이디.cafe24app.com/아이디_앱이름.git
CAFE24_GIT_URL=

NODE_ENV=production
PORT=8001
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
INITIAL_ADMIN_ID=admin
INITIAL_ADMIN_PASSWORD=
